---
import { getCollection } from "astro:content";
import { siteCopy } from "../config/site";

import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Divider from "../components/Divider.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ArticleCard from "../components/ArticleCard.astro";

const allProjects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const allArticles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const fullTitle = siteCopy.name + " - " + siteCopy.title;
---

<Layout title={fullTitle} description={siteCopy.description}>
  <Nav />

  <main>
    <!-- ============ HERO ZONE ============ -->
    <section class="zone-pro" id="about">
      <Hero />
    </section>

    <!-- ============ PROJECTS ============ -->
    {allProjects.length > 0 && <>
      <Divider label="making" />
      <section id="projects">
        <p class="section-heading">selected projects</p>
        <div class="project-grid">
          {allProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    </>}

    <!-- ============ EXPERIENCE ============ -->
    <Divider label="practice" />
    <section id="experience">
      <p class="section-heading">experience</p>
      <Experience />
    </section>

    <!-- ============ ARTICLES ============ -->
    {allArticles.length > 0 && <>
      <Divider label="writing" />
      <section id="articles">
        <p class="section-heading">technical articles</p>
        <div class="article-grid">
          {allArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      </section>
    </>}
  </main>

  <Footer />
</Layout>
