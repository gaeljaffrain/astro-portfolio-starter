---
import { consultingEnabled } from "../config/site";
---
<p class="eyebrow pro">
  {consultingEnabled ? "available for consulting" : "about me"}
</p>
<div class="hero">
  <div class="hero-copy">
    {
      consultingEnabled ? (
        <>
          <h1>Synthetic systems engineer — 10+ years at Tyroll Corp.</h1>
          <p class="lede">
            I build the visual systems for gen.2 android deployed in the mining colonies X145 and X156.
          </p>
          <p class="lede">
            Fun fact, I love unicorns for some reason.
          </p>
          <a class="btn-accent" href="#contact">Get in touch</a>
          <a class="btn-ghost" href="#consulting" style="margin-left: 8px;">
            How I work
          </a>
        </>
      ) : (
        <>
          <h1>Engineer building curious systems.</h1>
          <p class="lede">
            I&apos;m John Doe — engineer, tinkerer, and amateur philosopher of
            machine behavior.
          </p>
          <a class="btn-accent" href="#projects">See my projects</a>
        </>
      )
    }
  </div>
  <img
    class="hero-portrait"
    src="/images/hero.jpg"
    alt="John Doe, a fictional robotics engineer"
    width="1024"
    height="1024"
  />
</div>

{consultingEnabled && <div class="expertise-grid">
  <div class="expertise-card">
    <h3>Synthetic vision systems</h3>
    <p>
      Sensor fusion, image tuning, and perception validation for androids
      deployed off-earth.
    </p>
  </div>
  <div class="expertise-card">
    <h3>Human-machine interfaces</h3>
    <p>
      Behavioral modeling and interface design for machines deployed in mixed working environment (w/ legacy human workers).
    </p>
  </div>
</div>}

{consultingEnabled && <div class="work-with-me" id="consulting">
  <h3>Work with me</h3>
  <p>
    Systems audits, perception reviews, and prototype guidance for teams
    building androids, autonomous systems. Safety compliance expert.
  </p>
  <a class="btn-ghost" href="#contact">Discuss a project</a>
</div>}
