---
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { title, summary } = article.data;
const href = `/articles/${article.id}/`;
---

<a class="article-card" href={href}>
  <p class="article-kind">technical article</p>
  <h3>{title}</h3>
  <p>{summary}</p>
</a>